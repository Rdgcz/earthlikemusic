<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Earth Like Music</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/styles1.css" />
</head>

<body>
  <header class="hero" id="topo">
    <div class="container">
      <nav class="nav">
        <div class="brand">
          <!-- Substitua pelo logo -->
          <img class="logo" src="assets/elm_logo.png" alt="Earth Like Music" />
        </div>

        <div class="nav-actions">
          <a class="nav-link" href="#modalidades">Modalidades</a>
          <a class="nav-link" href="#portfolio">Portfólio</a>
          <a class="nav-link" href="#contato">Contato</a>
        </div>
      </nav>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="kicker">ALGUMAS IDEIAS</p>
          <p class="kicker">PEDEM O</p>
          <p class="kicker">RITMO CERTO.</p>

          <h1 class="hero-question">SUA MUSICA ESTÁ PRONTA PARA SE TORNAR INEVITÁVEL?</h1>
          <p class="hero-sub">
            A Earth Like Music é um selo boutique de identidade sonora, direção artística e produção premium.
          </p>

          <div class="cta-row">
            <a class="btn primary" href="#modalidades">Por que trabalhar com a Earth Like Music?</a>
            <a class="btn ghost" href="#portfolio">Você vai entender no play.</a>
          </div>
        </div>

        <div class="hero-media">
          <!-- Placeholder: imagem / textura -->
          <div class="media-card">
            <p class="media-title">ELM</p>
            <p class="media-sub">Música como ativo. Produção como núcleo.</p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main>
    <section class="section" id="elm">
      <div class="container narrow">
        <h2 class="h2">A DIFERENÇA NÃO ESTÁ NO SOM.</h2>
        <h3 class="h3">ESTÁ NA INTENÇÃO.</h3>
        <p class="p">
          TODA MÚSICA COMEÇA COMO UMA IDÉIA.<br>
          MAS POUCAS IDÉIAS ENCONTRAM O AMBIENTE CERTO PARA SE TORNAREM INEVITÁVEIS.
        </p>
        <p class="p">A Earth Like Music existe para esse momento.</p>
      </div>
    </section>

    <section class="section" id="modalidades">
      <div class="container">
        <h2 class="h2 center">MODALIDADES</h2>
        <p class="p center muted">PARA ARTISTAS QUE SENTEM QUE CHEGOU A HORA DE DAR SEU PRÓXIMO PASSO MAIS IMPORTANTE.</p>

        <div class="cards">
          <article class="card">
            <h4 class="card-title">ELM ESTÚDIO</h4>
            <div class="divider"></div>
            <p class="card-text">• Produção musical premium com assinatura técnica ELM.<br>
              • O artista paga pelo serviço e mantém 100% da master.<br>
              • Indicado para quem busca excelência sem operação de selo.</p>
            <a class="btn primary full" href="#contato" data-pref="ELM ESTÚDIO">Produzir com o Estúdio</a>
          </article>

          <article class="card">
            <h4 class="card-title">ELM LABEL</h4>
            <div class="divider"></div>
            <p class="card-text">• Lançamentos oficiais pela Earth Like Music.<br>
              • A produção entra como investimento capitalizado (PFC).<br>
              • Para operar o lançamento, o artista aporta um budget mínimo de lançamento.</p>
            <a class="btn primary full" href="#contato" data-pref="ELM LABEL">Submeter para o selo</a>
          </article>

          <article class="card">
            <h4 class="card-title">ELM JV</h4>
            <div class="divider"></div>
            <p class="card-text">• Joint Venture por projeto (co-investimento).<br>
              • Para artistas com potencial real, base ou capital.<br>
              • Split fonográfico negociado caso a caso.</p>
            <a class="btn primary full" href="#contato" data-pref="ELM JV">Propor parceria</a>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="portfolio">
      <div class="container">
        <h2 class="h2 center">VOCÊ VAI ENTENDER NO PLAY.</h2>
        <p class="p center muted">PROJETOS REALIZADOS PELO PRODUTOR MUSICAL ALEXANDRE BASA, COM O PADRÃO EARTH LIKE MUSIC.</p>

        <div class="embeds">
          <!-- Substitua pelos iframes reais -->
          <div class="embed">
            <iframe style="border-radius:12px" src="https://open.spotify.com/embed/track/5CD1tkgnVZrmPu5myIAzC2?utm_source=generator"
              width="100%" height="152" frameborder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              loading="lazy"></iframe>
          </div>
          <div class="embed">
            <iframe style="border-radius:12px" src="https://open.spotify.com/embed/track/5CD1tkgnVZrmPu5myIAzC2?utm_source=generator"
              width="100%" height="152" frameborder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              loading="lazy"></iframe>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="contato">
      <div class="container">
        <h2 class="h2">CONTATO</h2>
        <p class="p muted">Envie seu material e diga em qual modalidade você quer entrar.</p>

        <form class="form" action="mailto:suprabasa@gmail.com" method="post" enctype="text/plain">
          <div class="row">
            <label>Nome
              <input name="nome" required placeholder="Seu nome" />
            </label>
            <label>Email ou WhatsApp
              <input name="contato" required placeholder="email@exemplo.com ou +55..." />
            </label>
          </div>

          <label>Link do material (Spotify/YouTube/Drive)
            <input name="link" required placeholder="Cole o link aqui" />
          </label>

          <label>Modalidade
            <select name="modalidade" id="modalidade">
              <option>ELM ESTÚDIO</option>
              <option>ELM LABEL</option>
              <option>ELM JV</option>
            </select>
          </label>

          <label>Mensagem
            <textarea name="mensagem" rows="5" placeholder="Contexto do projeto, objetivos, prazos…"></textarea>
          </label>

          <button class="btn primary" type="submit">Enviar</button>
        </form>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-row">
      <p class="muted">Algumas ideias pedem o ritmo certo.</p>
      <a class="nav-link" href="#topo">Topo ↑</a>
    </div>
  </footer>

  <script>
    // Preseleciona modalidade ao clicar nos botões dos cards
    document.querySelectorAll('[data-pref]').forEach(btn => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-pref');
        const select = document.getElementById('modalidade');
        if (select) select.value = val;
      });
    });
  </script>
</body>
</html>